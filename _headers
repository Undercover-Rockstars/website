# Cloudflare Pages response headers.
# CSS and JS carry a ?v=<content hash> stamped by tools/build-dist.sh, so their
# URLs change whenever the file does and they can be cached immutably.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  # Camera stays disabled site-wide. That is correct for phase 0 of the fit
  # app, which captures nothing and asks for no permission. The phase that
  # wires the camera (#4) must scope a camera exception for /fit/ into this
  # policy in the same commit, or getUserMedia will be blocked there.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.png
  Cache-Control: public, max-age=604800

/assets/*.svg
  Cache-Control: public, max-age=604800

# The two machine-readable files are served cross-origin on purpose: an agent
# running in a browser context cannot read them otherwise. Both are public,
# generated from the same data as the pages, and carry no user data.

/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/catalogue.json
  Cache-Control: public, max-age=3600
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

# Point at the catalogue from the pages themselves, so a HEAD request finds it
# without parsing HTML. Listed per page rather than on /*, to keep it off assets.

/
  Link: </catalogue.json>; rel="alternate"; type="application/json"; title="Product catalogue"

/collection/
  Link: </catalogue.json>; rel="alternate"; type="application/json"; title="Product catalogue"

/product/*
  Link: </catalogue.json>; rel="alternate"; type="application/json"; title="Product catalogue"

# The fit app's service worker must always be revalidated, never served from
# a stale HTTP cache, or /fit/ would lag behind deploys. Browsers already
# bypass the HTTP cache for worker scripts by default; this makes it explicit.

/fit/sw.js
  Cache-Control: no-cache

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
